---
layout: base.njk
seccionMenu: inicio
description: "Consultora de bibliotecarios y documentalistas, distribuidor de Bibliotheca en Chile: digitalización, productos Bibliotheca y plataformas con IA para bibliotecas."
---
{#- =============================================================
    PORTADA
    Textos del hero: src/_data/sitio.json → "inicio"
    Líneas y servicios: src/_data/servicios.json
    Logos: src/_data/clientes.json
    ============================================================= -#}

{#- 1. Hero fijo: un mensaje y un llamado a la acción #}
<section class="hero" aria-labelledby="titulo-inicio">
  <div class="contenedor dividido">
    <div class="hero__texto">
      <p class="antetitulo">{{ sitio.inicio.antetitulo }}</p>
      <h1 id="titulo-inicio">{{ sitio.inicio.titulo }}</h1>
      <p class="bajada">{{ sitio.inicio.bajada }}</p>
      <div class="acciones">
        <a class="boton boton--principal" href="/contacto/">Solicitar cotización {% icono "arrow-right" %}</a>
        {% set claseBoton = "boton--secundario" %}{% include "parciales/boton-whatsapp.njk" %}
      </div>
      <div class="dato-hero">
        <img src="/assets/img/marca/partner-bibliotheca.png" alt="Partner de Bibliotheca" width="272" height="124">
        <span>{{ clientes.length }} instituciones confían en nosotros</span>
      </div>
    </div>
    <div class="marco hero__imagen">
      {% imagen sitio.inicio.imagen, sitio.inicio.imagenAlt, "(min-width: 56rem) 50vw, 92vw", { prioridad: true, anchos: [480, 900] } %}
    </div>
  </div>
</section>

{#- 2. Tres líneas de servicio (pestañas: información revelada de a poco) #}
<section class="seccion seccion--blanca" id="servicios" aria-labelledby="titulo-servicios">
  <div class="contenedor">
    <div class="encabezado encabezado--centro revelar">
      <p class="antetitulo">Qué hacemos</p>
      <h2 id="titulo-servicios">Tres líneas de servicio</h2>
    </div>

    <div class="pestanas" data-pestanas>
      <div class="pestanas__lista" role="tablist" aria-label="Líneas de servicio">
        {%- for linea in servicios.lineas %}
        <button class="pestana" type="button" role="tab" id="pestana-{{ linea.id }}" aria-controls="panel-{{ linea.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">{{ linea.nombre }}</button>
        {%- endfor %}
      </div>

      {%- for linea in servicios.lineas %}
      <div class="pestanas__panel" role="tabpanel" id="panel-{{ linea.id }}" aria-labelledby="pestana-{{ linea.id }}" {% if not loop.first %}data-oculto{% endif %}>
        <div class="linea">
          <div class="marco linea__imagen">
            {% imagen linea.imagen, linea.imagenAlt, "(min-width: 56rem) 55vw, 92vw", { anchos: [480, 900, 1600] } %}
          </div>
          <div>
            <h3>{{ linea.nombre }}</h3>
            <p class="bajada">{{ linea.descripcion }}</p>
            <ul class="linea__lista">
              {%- for s in servicios.items | deLinea(linea.id) %}
              <li><a href="/servicio/{{ s.slug }}/">{{ s.nombre }} {% icono "arrow-right" %}</a></li>
              {%- endfor %}
            </ul>
          </div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

{#- 3. Partner Bibliotheca (banda oscura) #}
<section class="seccion oscuro" aria-labelledby="titulo-partner">
  <div class="contenedor dividido">
    <div class="revelar">
      <img class="banda-partner__logo" src="/assets/img/marca/bibliotheca-blanco.png" alt="Bibliotheca" width="620" height="99" loading="lazy">
      <h2 id="titulo-partner">{{ sitio.partner.titulo }}</h2>
      <div class="acciones">
        <a class="boton boton--claro" href="/nuestros-servicios/#productos-bibliotheca">Ver productos Bibliotheca {% icono "arrow-right" %}</a>
      </div>
    </div>
    <div class="banda-partner__fotos">
      <div class="marco revelar revelar--2">
        {% imagen "servicios/lockers-inteligentes-1.jpg", "Usuaria retira un libro reservado desde un locker inteligente rojo", "(min-width: 56rem) 26vw, 45vw", { anchos: [480, 800] } %}
      </div>
      <div class="marco revelar revelar--3">
        {% imagen "servicios/inventarios-1.jpg", "Lector RFID de mano con un teléfono acoplado recorre los lomos de los libros en una estantería", "(min-width: 56rem) 26vw, 45vw", { anchos: [480, 900] } %}
      </div>
    </div>
  </div>
</section>

{#- 4. Quiénes somos (resumen) #}
<section class="seccion" aria-labelledby="titulo-nosotros">
  <div class="contenedor dividido dividido--invertido">
    <div class="revelar">
      <p class="antetitulo">{{ sitio.quienesSomos.titulo }}</p>
      <h2 id="titulo-nosotros">Bibliotecarios documentalistas al servicio de tu biblioteca</h2>
      <p class="bajada">{{ sitio.quienesSomos.texto[1] }}</p>
      <div class="acciones">
        <a class="boton boton--secundario" href="/quienes-somos/">Más sobre {{ sitio.nombre }}</a>
      </div>
    </div>
    <div class="marco marco--cuadrado revelar revelar--2">
      {% imagen "lineas/equipo.png", "Profesionales trabajando con computadores portátiles", "(min-width: 56rem) 45vw, 92vw", { anchos: [480, 900] } %}
    </div>
  </div>
</section>

{#- 5. Clientes #}
<section class="seccion seccion--blanca" aria-labelledby="titulo-clientes">
  <div class="contenedor">
    <div class="encabezado encabezado--centro revelar">
      <p class="antetitulo">Clientes</p>
      <h2 id="titulo-clientes">{{ sitio.clientes.titulo }}</h2>
    </div>
    {% include "parciales/logos.njk" %}
  </div>
</section>

{#- 6. Llamado final #}
{% include "parciales/cierre.njk" %}
